# Redis sürümü. REDIS_IMAGE boş bırakılırsa init.sh bu etiketi çekip
# digest ile sabitlenmiş halini REDIS_IMAGE'a yazar.
REDIS_VERSION=7.4.11
# Örn: redis:7.4.11@sha256:<digest>
REDIS_IMAGE=

# Portun publish edileceği, kurulum yapılan sunucunun IP adresi (0.0.0.0 KULLANMAYIN).
# Boş bırakılırsa init.sh sunucudaki IP'leri bulur; tek IP varsa onu,
# birden fazlaysa sorarak seçtirir ve buraya yazar.
REDIS_BIND_IP=
REDIS_PUBLISHED_PORT=6379

# Uygulama kullanıcıları burada değil, ./app.sh ile yönetilir (config/apps).

# Container bellek limitleri. config/redis.conf içindeki maxmemory
# REDIS_MEM_LIMIT'in ~%65-70'i olacak şekilde ayarlanmalı.
REDIS_MEM_LIMIT=3g
REDIS_MEM_RESERVATION=2g
REDIS_CPUS=2

ENVIRONMENT=production

# --- init.sh TLS üretimi (tls/ altında sertifika varsa kullanılmaz) ---
REDIS_TLS_CN=main-redis
# localhost, 127.0.0.1 ve REDIS_BIND_IP otomatik eklenir.
# İstemciler DNS adı veya LB VIP'i ile bağlanacaksa İLK kurulumdan önce ekleyin, örn:
#   REDIS_TLS_EXTRA_SAN=DNS:redis.kurum.local,IP:10.0.0.100
REDIS_TLS_EXTRA_SAN=
REDIS_TLS_DAYS=825
REDIS_CA_DAYS=3650
